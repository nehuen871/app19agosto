# Copiar a .env y completar secretos locales; nunca versionar .env.
POSTGRES_DB=utnfrba
POSTGRES_USER=utnfrba
POSTGRES_PASSWORD=
DB_POOL_MAX=10
API_PORT=4000
ADMIN_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
# Dominios exactos separados por coma para el login institucional.
ALLOWED_EMAIL_DOMAINS=

MOBILE_PORT=8081

# Web Push: generar una vez y conservar el par; la clave privada sólo va al backend.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Google Calendar: OAuth web application. Keep credentials only in .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_PUBLIC_URL=http://localhost:8081

# Login Google (mobile/web y admin): habilitar después de configurar OAuth.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_APP_ACCESS=institutional
ADMIN_PUBLIC_URL=http://localhost:3001
# Correos completos, verificados y separados por coma. Vacío bloquea el admin OAuth.
ADMIN_GOOGLE_EMAILS=19deagosto.utn@gmail.com

# Direcciones entre servidores (Docker DNS; nunca localhost dentro de contenedores).
API_URL=http://api:4000/api/v1
API_INTERNAL_URL=http://api:4000
# API de la web compilada: ruta relativa para usar el proxy del mismo dominio.
EXPO_PUBLIC_WEB_API_URL=/api/v1
# API al ejecutar Expo web en desarrollo (sin el proxy del contenedor web).
EXPO_PUBLIC_DEV_WEB_API_URL=http://localhost:4000/api/v1
# IP de publicación de puertos locales. Usar 0.0.0.0 sólo si se desea acceso por red.
BIND_ADDRESS=127.0.0.1

# Opcional para PostgreSQL externo (no completar si se usa el servicio db de Compose).
# DATABASE_URL=postgresql://usuario:password@servidor:5432/base
