{
  "name": "@utn/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc",
    "test": "tsx --test src/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "test:security": "tsx --test src/security.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@utn/validation": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.28.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0"
  }
}
