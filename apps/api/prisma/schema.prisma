generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum AccountRole {
  USER
  ADMIN
}
enum SessionPurpose {
  APP
  ADMIN
}
model Account {
  id String @id @default(uuid())
  googleSubject String @unique
  email String
  name String
  role AccountRole @default(USER)
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AuthSession[]
  nativeTickets NativeLoginTicket[]
}
model AuthSession {
  tokenHash String @id
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose SessionPurpose
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId])
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  browserHash String
  verifier String
  purpose SessionPurpose
  nativeChallenge String?
  nativeState String?
  expiresAt DateTime
  @@index([expiresAt])
}
model NativeLoginTicket {
  tokenHash String @id
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  challenge String
  expiresAt DateTime
  @@index([expiresAt])
}
enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  news News[]
}
model News {
  id String @id @default(cuid())
  title String
  slug String @unique
  summary String
  content String
  coverImageUrl String?
  coverImageId String?
  coverImage MediaImage? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  status NewsStatus @default(DRAFT)
  featured Boolean @default(false)
  publishedAt DateTime?
  notifications Notification[]
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([coverImageId])
}

model MediaImage {
  id String @id @default(uuid())
  mimeType String
  data Bytes
  byteSize Int
  createdAt DateTime @default(now())
  news News[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}
enum EventColor {
  BLUE
  YELLOW
  LIGHT_BLUE
  CYAN_GRAY
}
model CalendarEvent {
  id String @id @default(uuid())
  title String @db.VarChar(160)
  description String
  location String @db.VarChar(300)
  startsAt DateTime
  endsAt DateTime
  color EventColor @default(BLUE)
  status EventStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt])
  @@index([endsAt])
}

enum NotificationStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  PARTIAL
  FAILED
}
model Notification {
  id String @id @default(cuid())
  title String @db.VarChar(100)
  body String @db.VarChar(500)
  status NotificationStatus @default(DRAFT)
  newsId String?
  news News? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  requestedRecipients Int @default(0)
  sentCount Int @default(0)
  failedCount Int @default(0)
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveries PushDelivery[]
  @@index([createdAt])
  @@index([newsId])
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([entityId])
}

model PushSubscription {
  id String @id @default(cuid())
  endpointHash String @unique
  subscription Json
  revokeHash String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([enabled])
}
model PushDelivery {
  id String @id @default(cuid())
  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  status String @default("QUEUED")
  claimedAt DateTime?
  errorCode String?
  @@unique([notificationId, subscriptionId])
  @@index([status])
}
