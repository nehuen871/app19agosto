generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum AccountRole {
  USER
  ADMIN
}
enum SessionPurpose {
  APP
  ADMIN
}
enum Specialty {
  NAVAL
  CIVIL
  TEXTIL
  SISTEMAS
  MECANICA
  INDUSTRIAL
  ELECTRONICA
  ELECTRICA
  QUIMICA
}
model Account {
  id String @id @default(uuid())
  googleSubject String @unique
  email String
  name String
  specialty Specialty?
  studyPlanId String?
  studyPlan StudyPlan? @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  studentProgress StudentProgress[]
  role AccountRole @default(USER)
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calendarTickets CalendarAuthorizationTicket[]
  refreshTokens AuthRefreshToken[]
  sessions AuthSession[]
  nativeTickets NativeLoginTicket[]
  @@index([studyPlanId])
}

enum StudyStatus {
  PENDING
  TAKING
  REGULAR
  APPROVED
}
model StudyPlan {
  id String @id
  specialty Specialty
  version String
  name String
  sourceUrl String
  verifiedAt DateTime
  notes String
  courses StudyCourse[]
  accounts Account[]
  @@unique([specialty, version])
}
model StudyCourse {
  id String @id
  planId String
  plan StudyPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  code String
  name String
  year Int
  kind String @default("SUBJECT")
  requirements Json
  notes String
  progress StudentProgress[]
  @@unique([planId, code])
}
model StudentProgress {
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  courseId String
  course StudyCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status StudyStatus @default(PENDING)
  updatedAt DateTime @updatedAt
  @@id([accountId, courseId])
  @@index([courseId])
}
model AuthSession {
  tokenHash String @id
  familyId String?
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose SessionPurpose
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId])
  @@index([expiresAt])
  @@index([familyId])
}
model AuthRefreshToken {
  tokenHash String @id
  familyId String
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([familyId])
  @@index([accountId])
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  browserHash String
  verifier String
  purpose SessionPurpose
  nativeChallenge String?
  nativeState String?
  expiresAt DateTime
  @@index([expiresAt])
}
model NativeLoginTicket {
  tokenHash String @id
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  challenge String
  expiresAt DateTime
  @@index([expiresAt])
}
enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  news News[]
  @@index([parentId])
}
model News {
  id String @id @default(cuid())
  title String
  slug String @unique
  summary String
  content String
  coverImageUrl String?
  coverImageId String?
  coverImage MediaImage? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  status NewsStatus @default(DRAFT)
  featured Boolean @default(false)
  publishedAt DateTime?
  notifications Notification[]
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([coverImageId])
}

model MediaImage {
  id String @id @default(uuid())
  mimeType String
  data Bytes
  byteSize Int
  createdAt DateTime @default(now())
  news News[]
  usefulLinks UsefulLink[]
}

model UsefulLink {
  id String @id @default(uuid())
  title String
  description String
  url String
  imageId String
  image MediaImage @relation(fields: [imageId], references: [id], onDelete: Restrict)
  priority Int @default(100)
  featured Boolean @default(false)
  published Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([deletedAt, published, priority, id])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}
enum EventColor {
  BLUE
  YELLOW
  LIGHT_BLUE
  CYAN_GRAY
}
model CalendarAuthorizationTicket {
  tokenHash String @id
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId String
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purpose SessionPurpose
  expiresAt DateTime
  @@index([accountId])
  @@index([expiresAt])
}
model CalendarEvent {
  authorizationTickets CalendarAuthorizationTicket[]
  id String @id @default(uuid())
  title String @db.VarChar(160)
  description String
  location String @db.VarChar(300)
  startsAt DateTime
  endsAt DateTime
  color EventColor @default(BLUE)
  status EventStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt])
  @@index([endsAt])
}

enum NotificationStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  PARTIAL
  FAILED
}
model Notification {
  id String @id @default(cuid())
  title String @db.VarChar(100)
  body String @db.VarChar(500)
  status NotificationStatus @default(DRAFT)
  newsId String?
  news News? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  requestedRecipients Int @default(0)
  sentCount Int @default(0)
  failedCount Int @default(0)
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveries PushDelivery[]
  @@index([createdAt])
  @@index([newsId])
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([entityId])
}

model PushSubscription {
  id String @id @default(cuid())
  provider String @default("web")
  endpointHash String @unique
  subscription Json
  revokeHash String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([enabled])
}
model PushDelivery {
  id String @id @default(cuid())
  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  status String @default("QUEUED")
  claimedAt DateTime?
  errorCode String?
  expoTicketId String?
  receiptCheckAt DateTime?
  @@unique([notificationId, subscriptionId])
  @@index([status])
  @@index([status, receiptCheckAt])
}
